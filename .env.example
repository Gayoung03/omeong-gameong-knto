# Mobile
# 주의: EXPO_PUBLIC_* 값은 이 파일이 아니라 apps/mobile/.env 에 넣어야 합니다.
#       Expo 는 expo start 를 실행하는 폴더(apps/mobile)에서 .env 를 읽습니다.
#       아래 항목은 apps/mobile/.env.example 을 참고하세요.

# API
APP_NAME=Omeong Gameong API
ENVIRONMENT=local
# 비밀번호는 URL 인코딩해서 로컬 .env에만 입력합니다.
DATABASE_URL=postgresql+psycopg://omeong_app:<url-encoded-password>@omeong-gameong-db.c5wcc0qikv6f.ap-northeast-2.rds.amazonaws.com:5432/omeong?sslmode=require
# Alembic을 실행하는 관리자 계정입니다. make dev에서는 사용하지 않습니다.
MIGRATION_DATABASE_URL=
SECRET_KEY=

# Image storage (S3 bucket is private; public URLs use CloudFront)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=https://<distribution-domain>.cloudfront.net

# Local PostgreSQL (선택 사항, make dev-local에서만 사용)
POSTGRES_DB=omeong
POSTGRES_USER=omeong
POSTGRES_PASSWORD=omeong
POSTGRES_PORT=5432

# External APIs
TOUR_API_KEY=
WEATHER_API_KEY=
KAKAO_REST_API_KEY=
# 웹 브라우저 푸시용 VAPID 키. private key는 Railway에만 저장합니다.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:

# 소셜 로그인 (카카오). KAKAO_REST_API_KEY 를 client_id 로 함께 씁니다.
# 보안 강화(client secret)를 켰다면 KAKAO_CLIENT_SECRET, access_token_info 앱 ID
# 대조를 켜려면 KAKAO_APP_ID. KAKAO_REDIRECT_URI 는 콘솔에 등록한 값과 같아야 합니다.
KAKAO_CLIENT_SECRET=
KAKAO_APP_ID=
KAKAO_REDIRECT_URI=
# returnUrl 허용 프리픽스(콤마 구분). 비우면 local 은 exp://·http://localhost 허용,
# 그 외 환경은 반드시 설정해야 합니다(미설정 시 모든 returnUrl 이 422).
# 프로덕션 앱은 앱 스킴(app.config.ts 의 scheme) `omeonggameong://` 을, 배포 웹은
# 배포 오리진(예: https://<web-domain>)을 여기에 넣어야 카카오 복귀가 통과합니다.
# 예: OAUTH_RETURN_URL_PREFIXES=omeonggameong://,https://app.omeong.example
OAUTH_RETURN_URL_PREFIXES=
# 일반 챗봇과 별도로 바꿀 수 있는 루트 부분 수정 전용 모델입니다.
ROUTE_EDIT_MODEL=gpt-4o-mini
# 챗봇. 없으면 답변 생성만 502 로 실패하고 나머지 API 는 정상 동작합니다.
OPENAI_API_KEY=
# 비우면 gpt-4o-mini 를 씁니다. 모델은 설정값이라 코드를 고치지 않고 바꿉니다.
OPENAI_MODEL=
TMAP_API=

# --- 비밀번호 재설정 -------------------------------------------------------
# 셋 다 기본값이 있어 적지 않아도 됩니다. **빈 값(`KEY=`)으로 두지 마세요** —
# 숫자 설정이라 빈 문자열은 파싱에 실패해 서버가 기동하지 않습니다.
# 바꾸고 싶을 때만 주석을 풀고 숫자를 넣으세요.
#
# 인증번호 유효 시간(분). 기본 10.
# PASSWORD_RESET_CODE_TTL_MINUTES=10
# 코드 하나에 허용하는 입력 시도 횟수. 기본 5.
# 6자리는 100만 조합뿐이라 이 상한이 무차별 대입을 막는 유일한 장치입니다.
# PASSWORD_RESET_MAX_ATTEMPTS=5
# 한 계정에 1시간 동안 보낼 수 있는 코드 메일 수. 기본 5(메일함 폭탄 방지).
# PASSWORD_RESET_HOURLY_LIMIT=5

# --- 메일 발송 (SMTP) ------------------------------------------------------
# 세 개(HOST/USERNAME/PASSWORD)가 다 채워져야 실제로 보냅니다. 하나라도 비면
# 메일을 보내지 않고 로그로만 남깁니다(local 이면 인증번호가 터미널에 찍힘).
# **메일 작업을 하지 않는 팀원은 그냥 비워두세요** — 서버는 정상 기동합니다.
#
# 네이버 기준: 메일 > 환경설정 > POP3/IMAP 설정에서 "사용함" 으로 켜고,
# 네이버 ID 보안설정에서 2단계 인증 + 애플리케이션 비밀번호를 발급받습니다.
# SMTP_PASSWORD 에는 로그인 비밀번호가 아니라 그 애플리케이션 비밀번호를 넣습니다.
SMTP_HOST=
# 465 = 접속부터 SSL(네이버 기본), 587 = 접속 후 STARTTLS.
SMTP_PORT=465
# 587 을 쓸 때만 false 로 바꿉니다.
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
# 비워두면 SMTP_USERNAME 을 발신 주소로 씁니다. 로그인 계정과 다른 주소를 넣으면
# 대부분의 메일 서버가 거절하므로, 보통 비워둡니다.
SMTP_FROM_EMAIL=
# 받는 사람 메일함에 보이는 발신자 이름.
SMTP_FROM_NAME=오멍가멍
# 메일 서버가 응답하지 않을 때 포기하는 시간(초). 비우지 마세요 — 숫자 설정이라
# 빈 문자열은 파싱에 실패해 서버가 기동하지 않습니다.
SMTP_TIMEOUT_SECONDS=10
