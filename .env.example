# Mobile
# 주의: EXPO_PUBLIC_* 값은 이 파일이 아니라 apps/mobile/.env 에 넣어야 합니다.
#       Expo 는 expo start 를 실행하는 폴더(apps/mobile)에서 .env 를 읽습니다.
#       아래 항목은 apps/mobile/.env.example 을 참고하세요.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_KAKAO_JS_KEY=

# API
APP_NAME=Omeong Gameong API
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://omeong:omeong@localhost:5432/omeong
SECRET_KEY=

# PostgreSQL Docker
POSTGRES_DB=omeong
POSTGRES_USER=omeong
POSTGRES_PASSWORD=omeong
POSTGRES_PORT=5432

# External APIs
TOUR_API_KEY=
WEATHER_API_KEY=
KAKAO_REST_API_KEY=
LLM_API_KEY=
