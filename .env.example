# Mobile
# 주의: EXPO_PUBLIC_* 값은 이 파일이 아니라 apps/mobile/.env 에 넣어야 합니다.
#       Expo 는 expo start 를 실행하는 폴더(apps/mobile)에서 .env 를 읽습니다.
#       아래 항목은 apps/mobile/.env.example 을 참고하세요.

# API
APP_NAME=Omeong Gameong API
ENVIRONMENT=local
# 비밀번호는 URL 인코딩해서 로컬 .env에만 입력합니다.
DATABASE_URL=postgresql+psycopg://omeong_app:<url-encoded-password>@omeong-gameong-db.c5wcc0qikv6f.ap-northeast-2.rds.amazonaws.com:5432/omeong?sslmode=require
# Alembic을 실행하는 관리자 계정입니다. make dev에서는 사용하지 않습니다.
MIGRATION_DATABASE_URL=
SECRET_KEY=

# Image storage (S3 bucket is private; public URLs use CloudFront)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=https://<distribution-domain>.cloudfront.net

# Local PostgreSQL (선택 사항, make dev-local에서만 사용)
POSTGRES_DB=omeong
POSTGRES_USER=omeong
POSTGRES_PASSWORD=omeong
POSTGRES_PORT=5432

# External APIs
TOUR_API_KEY=
WEATHER_API_KEY=
KAKAO_REST_API_KEY=

# 소셜 로그인 (카카오). KAKAO_REST_API_KEY 를 client_id 로 함께 씁니다.
# 보안 강화(client secret)를 켰다면 KAKAO_CLIENT_SECRET, access_token_info 앱 ID
# 대조를 켜려면 KAKAO_APP_ID. KAKAO_REDIRECT_URI 는 콘솔에 등록한 값과 같아야 합니다.
KAKAO_CLIENT_SECRET=
KAKAO_APP_ID=
KAKAO_REDIRECT_URI=
# returnUrl 허용 프리픽스(콤마 구분). 비우면 local 은 exp://·http://localhost 허용,
# 그 외 환경은 반드시 설정해야 합니다(미설정 시 모든 returnUrl 이 422).
# 프로덕션 앱은 앱 스킴(app.config.ts 의 scheme) `omeonggameong://` 을, 배포 웹은
# 배포 오리진(예: https://<web-domain>)을 여기에 넣어야 카카오 복귀가 통과합니다.
# 예: OAUTH_RETURN_URL_PREFIXES=omeonggameong://,https://app.omeong.example
OAUTH_RETURN_URL_PREFIXES=
# 일반 챗봇과 별도로 바꿀 수 있는 루트 부분 수정 전용 모델입니다.
ROUTE_EDIT_MODEL=gpt-4o-mini
# 챗봇. 없으면 답변 생성만 502 로 실패하고 나머지 API 는 정상 동작합니다.
OPENAI_API_KEY=
# 비우면 gpt-4o-mini 를 씁니다. 모델은 설정값이라 코드를 고치지 않고 바꿉니다.
OPENAI_MODEL=
TMAP_API=
