# apps/mobile 전용 환경변수.
# 이 파일을 .env 로 복사해서 값을 채웁니다. (cp .env.example .env)
# Expo 는 expo start 를 실행하는 폴더에서 .env 를 읽으므로,
# 저장소 루트의 .env 가 아니라 이 폴더의 .env 를 사용해야 합니다.
#
# EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 그대로 포함됩니다.
# 노출돼도 되는 값만 넣으세요. (비밀 키는 백엔드 .env 로)

# 백엔드 주소. 실기기에서 접속할 때는 localhost 대신 PC 내부 IP 를 씁니다
EXPO_PUBLIC_API_URL=

# 카카오 개발자 콘솔의 JavaScript 앱 키 (내 여행 > 지도 탭)
# 개발자 콘솔 > 플랫폼 > Web 사이트 도메인에 https://localhost 를 등록해야 지도가 표시됩니다
EXPO_PUBLIC_KAKAO_JS_KEY=
