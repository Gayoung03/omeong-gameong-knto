// 오멍가멍 공모전 MVP ERD
// dbdiagram.io에 그대로 붙여 넣을 수 있습니다.

Enum auth_provider {
  local
  kakao
  apple
  google
}

Enum pet_species {
  dog
  cat
  rabbit
  bird
  other
}

Enum pet_size {
  small
  medium
  large
}

Enum trip_pace {
  relaxed
  normal
  packed
}

Enum transport_type {
  rental_car
  own_car
  taxi
  public_transport
  walk
  ferry
  airplane
}

Enum place_environment {
  indoor
  outdoor
  mixed
}

Enum pet_policy_type {
  indoor_allowed
  outdoor_only
  partial_allowed
  not_allowed
  unknown
}

Enum data_provider {
  tour_api
  kcisa
  visitjeju
  kakao
  tmap
  weather_api
  internal
}

Enum route_status {
  generating
  generated
  saved
  ongoing
  completed
  failed
}

Enum route_creation_type {
  recommended
  manual
}

Enum schedule_item_type {
  attraction
  restaurant
  cafe
  accommodation
  custom
}

Enum weather_condition {
  sunny
  partly_cloudy
  cloudy
  rainy
  snowy
  windy
}

Enum message_role {
  user
  assistant
  system
}

Table users {
  id uuid [pk]
  email varchar(255) [unique]
  password_hash varchar(255)
  auth_provider auth_provider [not null, default: 'local']
  provider_user_id varchar(255)
  nickname varchar(50) [not null]
  profile_image_url text
  inquiry_answer_notification_enabled boolean [not null, default: true]
  marketing_notification_enabled boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (auth_provider, provider_user_id) [unique]
  }
}

Table pets {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  name varchar(50) [not null]
  species pet_species [not null]
  species_detail varchar(50)
  breed varchar(100)
  size pet_size
  weight_kg decimal(5,2)
  birth_date date
  image_url text
  health_notes text
  is_primary boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table user_travel_preferences {
  user_id uuid [pk, ref: > users.id]
  default_pace trip_pace
  default_transport transport_type
  departure_location varchar(100)
  preferred_duration_days int
  companion_count int [not null, default: 1]
  preferred_tags varchar[]
  updated_at timestamptz [not null]
}

Table user_social_accounts {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  provider auth_provider [not null, note: 'local 금지 (CHECK)']
  provider_user_id varchar(255) [not null]
  linked_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, provider_user_id) [unique]
  }
}

Table places {
  id uuid [pk]
  name varchar(200) [not null]
  category varchar(50) [not null]
  category_detail varchar(50) [note: 'AI 입출력: etc 세부 분류. category enum 은 불변']
  region varchar(50)
  address text
  road_address text
  latitude decimal(10,7) [not null]
  longitude decimal(10,7) [not null]
  phone varchar(50)
  homepage_url text
  primary_image_url text
  description text
  description_source data_provider
  environment place_environment
  amenities varchar[]
  average_stay_minutes int
  business_hours_raw text [note: 'AI 입출력: place_business_hours.raw_text 장소당 1값 이관 목적지(응답 미노출)']
  check_in_time time [note: 'AI 입출력: 숙박 체크인']
  check_out_time time [note: 'AI 입출력: 숙박 체크아웃']
  reservation_required boolean [not null, default: false]
  created_by_user_id uuid [ref: > users.id]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (latitude, longitude)
    category
    region
  }
}

Table place_external_refs {
  id uuid [pk]
  place_id uuid [not null, ref: > places.id]
  provider data_provider [not null]
  external_id varchar(255) [not null]
  source_url text
  source_updated_at timestamptz
  last_synced_at timestamptz [not null]

  indexes {
    (provider, external_id) [unique]
    (place_id, provider)
  }
}

Table place_business_hours {
  id bigint [pk, increment]
  place_id uuid [not null, ref: > places.id]
  day_of_week smallint [not null]
  opens_at time
  closes_at time
  break_start_at time
  break_end_at time
  is_closed boolean [not null, default: false]
  raw_text text

  indexes {
    (place_id, day_of_week) [unique]
  }
}

Table place_pet_policies {
  id uuid [pk]
  place_id uuid [not null, ref: > places.id]
  policy_type pet_policy_type [not null, default: 'unknown']
  allowed_species varchar[]
  allowed_sizes varchar[]
  max_weight_kg decimal(5,2)
  carrier_required boolean
  leash_required boolean
  vaccination_required boolean
  extra_fee_amount int
  notes text
  source data_provider [not null]
  source_url text
  verified_at timestamptz
  reliability_score decimal(5,2)
  muzzle_required boolean [note: 'AI 입출력: 입마개 필수 (nullable=미확인)']
  food_area_allowed boolean [note: 'AI 입출력: 식음료 공간 동반 가능 (nullable=미확인)']
  max_pets_per_person smallint [note: 'AI 입출력: 1인당 동반 마리수 상한 (>=1)']
  caution_note varchar(150) [note: 'AI 입출력: 정제 주의사항 (원본 notes 는 별도 보존)']
}

Table place_tags {
  id bigint [pk, increment]
  code varchar(50) [unique, not null]
  name varchar(50) [not null]
}

Table place_tag_links {
  place_id uuid [ref: > places.id]
  tag_id bigint [ref: > place_tags.id]
  confidence decimal(4,3)
  source data_provider [not null]

  indexes {
    (place_id, tag_id) [pk]
  }
}

Table route_requests {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  title varchar(150)
  start_at timestamptz [not null]
  end_at timestamptz [not null]
  departure_location varchar(100)
  departure_place_id uuid [ref: > places.id]
  pace trip_pace [not null]
  transport transport_type [not null]
  companion_count int [not null, default: 1]
  preferred_tags varchar[]
  priority_preset varchar(30)
  applied_weights jsonb
  request_text text
  created_at timestamptz [not null]
}

Table route_request_pets {
  route_request_id uuid [ref: > route_requests.id]
  pet_id uuid [ref: > pets.id]

  indexes {
    (route_request_id, pet_id) [pk]
  }
}

Table route_request_stays {
  id uuid [pk]
  route_request_id uuid [not null, ref: > route_requests.id]
  place_id uuid [ref: > places.id]
  name varchar(200) [not null]
  address text
  check_in_at timestamptz
  check_out_at timestamptz
}

Table routes {
  id uuid [pk]
  route_request_id uuid [ref: > route_requests.id]
  user_id uuid [not null, ref: > users.id]
  title varchar(150) [not null]
  status route_status [not null, default: 'generating']
  creation_type route_creation_type [not null]
  version int [not null, default: 1]
  start_at timestamptz [not null]
  end_at timestamptz [not null]
  pace trip_pace [not null]
  transport transport_type [not null]
  explanation text
  total_score decimal(6,2)
  pet_safety_score decimal(6,2)
  cover_image_url text
  style_keywords varchar[]
  memo text
  share_token varchar(100) [unique]
  is_public boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (route_request_id, version) [unique]
    (user_id, status)
  }
}

Table route_pets {
  route_id uuid [ref: > routes.id]
  pet_id uuid [ref: > pets.id]

  indexes {
    (route_id, pet_id) [pk]
  }
}

Table route_days {
  id uuid [pk]
  route_id uuid [not null, ref: > routes.id]
  day_number int [not null]
  route_date date [not null]
  weather_snapshot_id uuid [ref: > weather_snapshots.id]
  title varchar(150)

  indexes {
    (route_id, day_number) [unique]
  }
}

Table route_items {
  id uuid [pk]
  route_day_id uuid [not null, ref: > route_days.id]
  place_id uuid [ref: > places.id]
  custom_place_name varchar(200)
  item_type schedule_item_type [not null]
  sort_order int [not null]
  starts_at timestamptz
  ends_at timestamptz
  stay_minutes int
  note text
  recommendation_score decimal(6,2)
  recommendation_reason text
  is_selected boolean [not null, default: true]

  indexes {
    (route_day_id, sort_order) [unique]
  }
}

Table route_moves {
  id uuid [pk]
  from_item_id uuid [not null, ref: > route_items.id]
  to_item_id uuid [not null, ref: > route_items.id]
  transport transport_type [not null]
}

Table weather_snapshots {
  id uuid [pk]
  region varchar(50) [not null]
  latitude decimal(10,7)
  longitude decimal(10,7)
  forecast_at timestamptz [not null]
  condition weather_condition [not null]
  temperature decimal(4,1)
  min_temperature decimal(4,1)
  max_temperature decimal(4,1)
  precipitation_probability smallint
  humidity smallint
  wind_speed decimal(5,2)
  source_updated_at timestamptz [not null]

  indexes {
    (region, forecast_at) [unique]
  }
}

Table route_calculation_cache {
  id uuid [pk]
  origin_latitude decimal(10,7) [not null]
  origin_longitude decimal(10,7) [not null]
  destination_latitude decimal(10,7) [not null]
  destination_longitude decimal(10,7) [not null]
  transport transport_type [not null]
  requested_departure_at timestamptz
  distance_meters int [not null]
  duration_minutes int [not null]
  polyline text
  calculated_at timestamptz [not null]
  expires_at timestamptz [not null]

  indexes {
    expires_at
    (origin_latitude, origin_longitude, destination_latitude, destination_longitude, transport) [note: 'INCLUDE(expires_at) — 캐시 조회 index-only scan']
  }
}

Table route_checklist_items {
  id uuid [pk]
  route_id uuid [not null, ref: > routes.id]
  category varchar(30) [not null]
  label varchar(200) [not null]
  is_checked boolean [not null, default: false]
  is_recommended boolean [not null, default: false]
  sort_order int [not null, default: 0]
}

Table route_memos {
  id uuid [pk]
  route_id uuid [not null, ref: > routes.id]
  route_day_id uuid [ref: > route_days.id]
  title varchar(150)
  content text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table favorites {
  user_id uuid [ref: > users.id]
  place_id uuid [ref: > places.id]
  created_at timestamptz [not null]

  indexes {
    (user_id, place_id) [pk]
  }
}

Table reviews {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  place_id uuid [not null, ref: > places.id]
  pet_id uuid [ref: > pets.id]
  rating smallint [not null]
  content text
  pet_policy_accurate boolean
  visited_at date
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table review_images {
  id uuid [pk]
  review_id uuid [not null, ref: > reviews.id]
  image_url text [not null]
  sort_order int [not null, default: 0]
}

Table travel_logs {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  route_id uuid [ref: > routes.id]
  place_id uuid [ref: > places.id]
  place_name_snapshot varchar(200) [not null]
  recorded_date date [not null]
  visited_at timestamptz
  original_image_url text [not null]
  generated_image_url text
  writing_style varchar(30) [not null]
  mood varchar(30)
  generation_status varchar(20) [not null, default: 'idle']
  personal_message text
  is_representative boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (user_id, recorded_date)
    (route_id, recorded_date)
    (place_id, recorded_date)
  }
}

Table travel_log_pets {
  id uuid [pk]
  travel_log_id uuid [not null, ref: > travel_logs.id]
  pet_id uuid [ref: > pets.id]
  pet_name_snapshot varchar(50) [not null]
  pet_profile_image_snapshot text

  indexes {
    (travel_log_id, pet_id) [unique]
  }
}

Table inquiries {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  category varchar(50) [not null]
  status varchar(20) [not null, default: 'pending']
  title varchar(200) [not null]
  content text [not null]
  image_urls text[]
  answer text
  answered_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (user_id, status, created_at)
  }
}

Table notices {
  id uuid [pk]
  title varchar(200) [not null]
  content text [not null]
  is_pinned boolean [not null, default: false]
  is_active boolean [not null, default: true]
  published_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (is_active, is_pinned, published_at)
  }
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  type varchar(30) [not null]
  title varchar(150) [not null]
  content text [not null]
  icon_key varchar(50)
  action_path text
  is_read boolean [not null, default: false]
  created_at timestamptz [not null]
  read_at timestamptz

  indexes {
    (user_id, is_read, created_at)
    (user_id, created_at)
  }
}

Table chat_conversations {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  route_id uuid [ref: > routes.id]
  title varchar(150)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table chat_messages {
  id uuid [pk]
  conversation_id uuid [not null, ref: > chat_conversations.id]
  role message_role [not null]
  content text [not null]
  referenced_place_ids uuid[]
  model_name varchar(100)
  created_at timestamptz [not null]
}

// ─── 여행 가이드 콘텐츠 ────────────────────────────────
// 읽는 글(guide_documents)과 질의하는 값(transport_pet_rules)을 나눈다.
// 마크다운 본문만으로는 "12kg이면 어느 항공사?" 에 답할 수 없어서.

Enum guide_category {
  airline
  ferry
  preparation
}

Enum carrier_type {
  airline
  ferry
}

Enum breed_restriction_type {
  dangerous
  brachycephalic
}

Enum breed_restriction_scope {
  cabin
  cargo
  both
}

Table guide_documents {
  id uuid [pk]
  slug varchar(100) [not null, unique]
  title varchar(200) [not null]
  category guide_category [not null]
  body text [not null]
  display_order smallint [not null, default: 0]
  verified_at timestamptz
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    category
    is_active
  }
}

Table guide_document_sources {
  id uuid [pk]
  guide_document_id uuid [not null, ref: > guide_documents.id]
  source_name varchar(200) [not null]
  source_url text
  source_note varchar(200)
  verified_at timestamptz
  display_order smallint [not null, default: 0]
}

Table transport_pet_rules {
  id uuid [pk]
  guide_document_id uuid [not null, ref: > guide_documents.id]
  carrier_name varchar(50) [not null]
  carrier_type carrier_type [not null]
  route varchar(50) [note: '여객선만. 항공사는 null']
  cabin_allowed boolean [note: 'null = 확인 안 됨']
  cabin_max_weight_kg decimal(5,2) [note: '케이지 포함']
  cabin_weight_unlimited boolean [note: 'AI 입출력: true=무게 제한 없음 명시(null=미확인과 구분). 상한과 상호배제']
  cabin_conditions varchar(200) [note: 'AI 입출력: 조건부 사실(원칙 불가·예외 허용). allowed 와 쌍으로 관찰']
  cabin_fee_krw integer
  min_age_weeks_cabin smallint
  max_pets_per_person_cabin smallint
  max_pets_per_trip smallint
  cargo_allowed boolean
  cargo_max_weight_kg decimal(5,2)
  cargo_weight_unlimited boolean [note: 'AI 입출력: true=무게 제한 없음 명시. 상한과 상호배제']
  cargo_fee_threshold_kg decimal(5,2)
  cargo_fee_light_krw integer
  cargo_fee_heavy_krw integer
  min_age_weeks_cargo smallint
  pledge_required boolean
  online_checkin_allowed boolean
  same_day_request_allowed boolean
  request_deadline_hours smallint
  airport_cage_price_krw integer
  duration_minutes smallint [note: '여객선 소요 시간']
  notes text
  source_url text
  verified_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    carrier_type
    guide_document_id
  }
}

Table transport_restricted_breeds {
  id uuid [pk]
  transport_pet_rule_id uuid [not null, ref: > transport_pet_rules.id]
  breed_name_ko varchar(100) [not null]
  breed_name_en varchar(100)
  breed_aliases varchar[]
  restriction_type breed_restriction_type [not null]
  applies_to breed_restriction_scope [not null]
  is_example_only boolean [not null, default: false, note: '원문이 예시만 든 경우']

  indexes {
    transport_pet_rule_id
    breed_name_ko
  }
}
